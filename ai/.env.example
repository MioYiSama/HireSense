# ==========================================
# AI Interview Agent 环境配置文件模板 (.env.example)
# 使用说明：复制本文件，重命名为 .env，并填入真实的配置信息。
# 警告：绝不允许将包含真实 Key 的 .env 文件提交到 Git 仓库！
# ==========================================

# ---------------------------------------------------------
# 1. 大模型 API 配置 (LLM Configuration)
# ---------------------------------------------------------
# 填入你的真实 API Key (是阿里云 DashScope，以 sk- 开头)
LLM_API_KEY=sk-your-api-key-here
# 如果使用 OpenAI 官方，填 https://api.openai.com/v1；若是代理或千问，填对应的 Base URL
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 意图识别等低延迟场景使用的小模型
FAST_LLM_MODEL=qwen-turbo
# 主要用于追问生成、简历解析等主流程的大模型
SMART_LLM_MODEL=qwen-max
# 主要用于最终报告生成的大模型
REPORT_LLM_MODEL=qwen-plus

# ---------------------------------------------------------
# 2. Neo4j 图数据库配置 (Graph Database Configuration)
# ---------------------------------------------------------
# 如果是本地 Docker 部署，保持默认；若是云数据库 AuraDB，替换为 neo4j+s://xxx
NEO4J_URI=bolt://localhost:7687
# Neo4j 用户名 (默认通常为 neo4j)
NEO4J_USER=neo4j
# 你的 Neo4j 密码 (⚠️ 注意：如果密码中包含 '#' 号，请务必在两侧加上双引号，例如 "MyPass#123")
NEO4J_PASSWORD=your_neo4j_password_here

# ---------------------------------------------------------
# 3. ChromaDB 向量库配置 (Vector Database Configuration)
# ---------------------------------------------------------
# 本地向量物理文件的存储路径 (相对路径或绝对路径均可)
CHROMA_PERSIST_DIR=./chroma_db_java_back_data

# ---------------------------------------------------------
# 4. 微服务通信配置 (Webhook & Service Integration)
# ---------------------------------------------------------
# 面试结束后，AI Agent 异步推送最终报告的目标主站 URL
# 本地测试时，可指向自身的 Mock 接口；生产上线时，改为企业真实的 HR 业务系统接口
TARGET_SERVER_URL=http://127.0.0.1:8000/api/interview/report

# 服务间通信鉴权密钥 (需与主站业务系统保持一致，防止恶意伪造报告)
INTERNAL_SECRET=your-internal-super-secret-key-here
